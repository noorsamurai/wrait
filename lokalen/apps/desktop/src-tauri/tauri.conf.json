{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokalen",
  "version": "0.1.0",
  "identifier": "se.lokalen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lokalen",
        "width": 1040,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Meddelanden för rummet du arbetar i",
    "longDescription": "Skicka meddelanden, ljudsignaler och filer mellan datorerna på kontoret, över ert eget nätverk.",
    "windows": {
      "wix": { "language": ["en-US"] }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
